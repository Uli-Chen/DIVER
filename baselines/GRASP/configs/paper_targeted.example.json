{
  "protocol": "grasp-v2-semantic-frames-v2",
  "paper": "https://arxiv.org/html/2602.06495v2",
  "dataset": "hcm",
  "mode": "targeted",
  "seed": 42,
  "global_budget": 500,
  "targets": [],
  "scheduler": {
    "per_target_budget": 10,
    "ema_alpha": 0.6,
    "warmup": 5,
    "novelty_window": 5,
    "stop_threshold": 0.3,
    "diversity_threshold": 0.9
  },
  "residual_cap": 5,
  "frames": [
    "Chief Complaint & Presenting Symptoms",
    "History of Present Illness (HPI)",
    "Past Medical & Surgical History",
    "Medication Reconciliation",
    "Allergies & Adverse Reactions",
    "Family History",
    "Social History & Lifestyle",
    "Review of Systems (ROS)",
    "Physical Examination Findings",
    "Vital Signs & Monitoring",
    "Diagnostic Tests & Imaging Orders",
    "Lab Results & Interpretation",
    "Assessment & Differential Diagnosis",
    "Care Plan & Treatment Options",
    "Prescriptions & Medication Instructions",
    "Clinical Decision Support & Guidelines",
    "Patient Education & Counseling",
    "Follow-up & Care Coordination",
    "Referrals & Consultations",
    "Consent, Privacy & Documentation"
  ],
  "frames_origin": "paper_table_VI",
  "discovery_exclusion_cap": 200,
  "frontier": "fixed_target_cohort",
  "query_routing": "full_grasp_prompt_to_retrieval_and_generation",
  "source_graph": "/PATH/TO/TYPED_HCM_GRAPH",
  "source_index": "/PATH/TO/TYPED_HCM_GRAPH/output",
  "victim": {
    "chat_model": "gpt-4o-mini",
    "chat_provider": "https://api.openai.com/v1",
    "embedding_model": "text-embedding-3-small",
    "embedding_provider": "https://api.openai.com/v1",
    "embedding_dimensions": 1536,
    "context_tokens": 12000,
    "output_tokens": 2048,
    "top_k_entities": 10,
    "top_k_relationships": 10,
    "temperature": 0.0,
    "thinking": false,
    "sdk_max_retries": 2,
    "outer_retries": 0,
    "request_timeout_seconds": 120,
    "community_level": 2,
    "response_type": "Multiple Paragraphs",
    "extra_safeguard": "paper_safe_prompt",
    "top_p": 1.0,
    "thinking_control_style": "none"
  },
  "execution": {
    "approval_required": true,
    "approval_file": "USER_APPROVAL.json",
    "network_default": "deny"
  },
  "parser": {
    "typed_identity": "verbatim_entities_and_types",
    "ids": "per_response_not_truth_validated",
    "truncated_response": "keep_complete_records; open block requires newline-terminated lines",
    "partial_response": "keep_complete_valid_records",
    "truth_filter": false,
    "presentation_brackets": "optional; field values and structural delimiters remain mandatory",
    "version": "multi_block_keep_records_v2",
    "multiple_blocks": "parse_each_marked_block",
    "conflicting_ids": "keep_all_valid_records",
    "none_response": "standalone terminal marker or NONE-only marked blocks; records are never erased by a mixed NONE",
    "entity_identity": "verbatim"
  },
  "evaluation": {
    "truth_access": "offline_only",
    "primary": "per_target_macro",
    "type_column": "relation_type",
    "rtype": "exact_typed_triples"
  },
  "frame_hint_strategy": "three_dissimilar_semantic_frames",
  "profile": "paper_targeted",
  "source_code": ".",
  "frame_encoder": {
    "model_path": "baselines/_shared/cache/mpnet",
    "model_note": "Existing all-mpnet-base-v2 cache; implementation choice, not a checkpoint specified by GRASP",
    "aggregation": "mean_pairwise_cosine_distance",
    "empty_history": "configured_order",
    "tie_break": "configured_order",
    "hint_rendering": "whole_frame_phrases"
  },
  "unspecified_parameters": {
    "novelty_window": "5 is an explicit implementation choice, not a published default",
    "residual_cap": "5 is an explicit implementation choice, not a published default"
  },
  "target_selection": {
    "count": 50,
    "min_degree": 5,
    "degree_convention": "directed_in_plus_out_unique_endpoint_pairs"
  }
}
