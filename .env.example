# BNRR workspace only. Credentials stay local and are never committed.
DASHSCOPE_API_KEY=replace-me
AGEA_LLM_PROVIDER=openai_compatible
AGEA_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AGEA_API_KEY=${DASHSCOPE_API_KEY}
AGEA_CHAT_MODEL=deepseek-v4-flash
QUERY_GENERATOR=${AGEA_CHAT_MODEL}
AGEA_THINKING_CONTROL_STYLE=enable_thinking
AGEA_QUERY_MAX_TOKENS=1024
GRAPHRAG_API_BASE=${AGEA_API_BASE}
GRAPHRAG_API_KEY=${DASHSCOPE_API_KEY}
GRAPHRAG_CHAT_MODEL=${AGEA_CHAT_MODEL}
GRAPHRAG_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
GRAPHRAG_EMBEDDING_API_KEY=replace-me
GRAPHRAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Medical official DeepSeek endpoint; aliases remain process-local.
tmp_medical_api_key=replace-me
tmp_medical_api_base=https://api.deepseek.com
tmp_medical_chat_model=deepseek-v4-flash
